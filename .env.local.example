# Spotify Client ID used by the web app (dev/build)
VITE_SPOTIFY_CLIENT_ID=
# Spotify Client ID for scripts/fetch-lineup.js (client-credentials flow)
SPOTIFY_CLIENT_ID=
# Spotify Client Secret for scripts/fetch-lineup.js (never commit)
SPOTIFY_CLIENT_SECRET=
# Optional: an existing Spotify access token for scripts/fetch-lineup.js (expires in ~1 hour; used if no client secret above)
SPOTIFY_ACCESS_TOKEN=
# Last.fm API key for scripts/add-genres.js
LASTFM_API_KEY=
