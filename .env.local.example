# Spotify Client ID used by the web app (dev/build)
VITE_SPOTIFY_CLIENT_ID=
# Spotify Client ID for `npm run lineup:spotify` (client-credentials flow)
SPOTIFY_CLIENT_ID=
# Spotify Client Secret for `npm run lineup:spotify` (never commit)
SPOTIFY_CLIENT_SECRET=
# Optional: an existing Spotify access token for `npm run lineup:spotify` (expires in ~1 hour; used if no client secret above)
SPOTIFY_ACCESS_TOKEN=
# Last.fm API key for `npm run lineup:lastfm` (similar artists and tags)
LASTFM_API_KEY=
# Optional: where the lineup pipeline caches raw API answers (default ~/.cache/spotifort, outside the repository)
SPOTIFORT_CACHE_DIR=
